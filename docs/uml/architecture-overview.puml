@startuml architecture-overview
' Overview of ChorNMT: the off-chain JavaScript pipeline and the on-chain Solidity contracts.
' Hand-written: update it when a component, a script, or a data flow changes.
!include style.iuml
left to right direction
skinparam rectangle {
  BackgroundColor #F4F8FB
  BorderColor #3A6EA5
}
skinparam file {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
}
skinparam package {
  BorderColor #8AA9C8
  FontStyle bold
}
skinparam ArrowColor #2F4F6F

package "Off-chain · JavaScript" as offchain {
  file "Source BPMN" as BPMN
  rectangle "Importer\nimport-bpmn.js" as IMP
  file "NMT dataset\n.nmt.json" as DS
  rectangle "choreography-model.js\nabi.encode" as CM
  file "BPMN updates" as UPD
  rectangle "apply-asset-delta.js" as APPLY
  file "tokenURI metadata\nJSON: roles + nodes\n(base64 data URI)" as META
  rectangle "Render\nweb3.js + bpmn-builder-js" as RENDER
  file "Regenerated BPMN" as OUT
}

package "On-chain · Solidity" as onchain {
  rectangle "MasterSmartPolicy" as MP
  rectangle "ChoreographyNMT\nERC-721" as NMT
  rectangle "Model contract\nSSTORE2" as MC
  rectangle "ChoreographyTokenURIRenderer" as TR
  rectangle "CreatorSmartPolicy" as CP
  rectangle "HolderSmartPolicy" as HP
  rectangle "ChoreographyMutableAsset" as CMA
}

BPMN --> IMP
IMP --> DS
DS --> CM
CM --> MC : deploys the code
UPD --> APPLY
APPLY --> CMA : setRoles + setNodes

MP --> NMT : authorizes mint
NMT --> CMA : creates and owns
NMT ..> MC : immutable
MC --> CMA : read at mint
NMT --> TR : tokenURI
TR --> CMA : reads
CP --> CMA : authorizes and\nconstrains updates
HP --> CMA : second approval

CMA --> META : tokenURI()
META --> RENDER : decode
RENDER --> OUT
@enduml
