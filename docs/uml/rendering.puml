@startuml rendering
' How the rendering works: the on-chain tokenURI computation and the off-chain pipeline that
' regenerates the BPMN from it (docs/rendering.md). The metadata is read the ERC-721 way, from the
' token contract: step 1 asks the asset for its NMT, steps 2-5 are one eth_call to
' ChoreographyNMT.tokenURI(tokenId), 6-10 run off-chain.
' Hand-written: update it when a render step, a script, a read function, or an output file changes.
!include style.iuml
skinparam ArrowColor #2F4F6F
skinparam component {
  BackgroundColor #F4F8FB
  BorderColor #3A6EA5
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #8AA9C8
}
skinparam rectangle {
  BorderColor #8AA9C8
}

rectangle "On-chain · read only, nothing stored" as chain #F2F8FD {
  component "ChoreographyNMT" <<contract, ERC-721>> as nmt
  component "ChoreographyTokenURIRenderer" <<contract, stateless>> as renderer
  component "ChoreographyMutableAsset" <<contract>> as asset
  note right of asset
    Its tokenURI() is a shortcut to
    step 2 (same value), not used here.
  end note
}

rectangle "Off-chain · JavaScript · npm run render:asset" as js #F1F9F3 {
  component "web3.js" <<reader>> as web3
  component "normalize.js" as normalize
  component "validation.js" as validation
  component "process-mapper.js" as mapper
  component "moddle-generator.js" as generator
  component "render-bpmn-images.js" <<optional>> as images

  artifact "~*.raw.generated.json" as raw
  artifact "~*.normalized.generated.json" as normalized
  artifact "~*.generated.bpmn.xml" as xml
  artifact "BPMN drawing (SVG)" as svg
}

' ---------- on-chain: the token contract answers, the renderer reads the asset ----------
nmt -right-> renderer : 3. tokenURI(asset)
renderer .right.> asset : 4. reads roles\nand nodes

' ---------- the read: tokenURI on the token contract ----------
web3 -up-> asset : 1. nmt()
web3 -up-> nmt : 2. eth_call\ntokenURI(tokenId)\ntokenId = uint160(asset)
nmt .down.> web3 : 5. base64 JSON\n(roles + nodes)


' ---------- off-chain pipeline ----------
web3 -right-> normalize : 6. model\nby names
normalize -right-> validation : 7. BPMN ids,\nresolved\nreferences
validation -right-> mapper : 8. checked\nmodel
mapper -right-> generator : 9. BPMN elements\n+ computed\nlayout (DI)
generator -right-> images : 10. BPMN\nXML

' ---------- files written ----------
web3 .down.> raw
normalize .down.> normalized
generator .down.> xml
images .down.> svg
@enduml
