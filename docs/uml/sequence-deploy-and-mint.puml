@startuml sequence-deploy-and-mint
!include style.iuml
title Deploy a choreography type and mint an instance (deploy:asset)

actor "Authority\n(account 0)" as Authority
participant "MasterSmartPolicy" as Master
participant "CreatorSmartPolicy" as Creator
participant "HolderSmartPolicy" as HolderPolicy
participant "ChoreographyTokenURIRenderer" as Renderer
participant "Model contract\n(SSTORE2)" as Model
participant "ChoreographyNMT" as NMT
participant "ChoreographyMutableAsset" as Asset

== Deploy the choreography type (once) ==
Authority -> Master ** : deploy
Authority -> Creator ** : deploy
Authority -> HolderPolicy ** : deploy
Authority -> Renderer ** : deploy
Authority -> Model ** : create(code = abi.encode(InitialModel))
Authority -> NMT ** : deploy(master, renderer, model)
note right of NMT : model is immutable:\none NMT, one choreography type

== Mint an instance ==
Authority -> NMT : mint(to, creator, holder)
activate NMT
NMT -> Master : evaluate(authority, action, nmt)
Master --> NMT : authorized creator AND eligible holder
alt denied
  NMT --> Authority : revert MasterDenied()
else allowed
  NMT -> Asset ** : new ChoreographyMutableAsset(nmt, creator, holder, model)
  activate Asset
  Asset -> Model : read code (extcodecopy)
  Asset -> Asset : abi.decode, _setRoles, _setNodes,\nemit ChoreographyInitialized(model)
  deactivate Asset
  NMT -> NMT : _mint(to, tokenId = asset address)
  NMT --> Authority : (asset, tokenId)
end
deactivate NMT

== Link the role accounts of the instance ==
Authority -> Asset : setRoles(names, accounts)
note right of Asset : policy checks as in sequence-apply-delta

note over Asset
  The model is part of the type and is not checked by
  the policies; roles are born with no account, and
  every later setRoles / setNodes is checked.
end note
@enduml
