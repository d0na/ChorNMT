classDiagram
  direction TB

  class ERC721Enumerable

  class NMT {
    <<abstract>>
    +mint(to, creatorPolicy, holderPolicy)
    +transferFrom(from, to, tokenId)
    +getMutableAssetAddress(tokenId)
    #_mint(to, creatorPolicy, holderPolicy)*
  }

  class MutableAsset {
    <<abstract>>
    +address nmt
    +bool linked
    +address creatorSmartPolicy
    +address holderSmartPolicy
    +getHolder()
    +setHolderSmartPolicy()
    +setCreatorSmartPolicy()
    +setLinked()
    +transferFrom(from, to)
  }

  class SmartPolicy {
    <<abstract>>
    +evaluate(subject, action, resource) bool
  }

  %% ---------- ChoreographyMutableAsset ----------
  class ChoreographyMutableAsset {
    -Descriptor descriptor
    +constructor(nmt, creatorPolicy, holderPolicy, model)
    +setRoles(roleNames, addresses)
    +setNodes(names, nodeTypes, incoming, outgoing, conditions, ...)
    +tokenURI() string
    +getNode(name) Node
    +getNodeNames() string[]
    +hasNode(name) bool
    +getNodeTypeAndOutgoing(name) uint8, string[]
    +getNodeTypeAndEdges(name) uint8, string[], string[]
    +getRole(role) address
    +hasRole(role) bool
    +getRoleNames() string[]
    -_evaluateRoleUpdate(roleNames, addresses)
    -_evaluateNodeUpdate(names, nodeTypes, incoming, outgoing)
    -_evaluateDomainUpdate(domainCall)
    -_approves(policy, domainCall) bool
    -_setRoles(roleNames, addresses)
    -_setNodes(...)
  }

  class Descriptor {
    <<struct>>
    mapping~string→Node~ nodesByName
    mapping~string→bool~ hasNode
    string[] nodeNames
    mapping~string→address~ roles
    mapping~string→bool~ hasRole
    string[] roleNames
  }

  class Node {
    <<struct>>
    string name
    NodeType nodeType
    string[] incoming
    string[] outgoing
    string[] conditions
    string initiatorRole
    string participantRole
    string initiatingMessage
    string returnMessage
  }

  class NodeType {
    <<enumeration>>
    START_EVENT
    END_EVENT
    TASK
    EXCLUSIVE_SPLIT
    EXCLUSIVE_JOIN
    PARALLEL_SPLIT
    PARALLEL_JOIN
    EVENT_BASED_GATEWAY
  }

  class InitialModel {
    <<struct>>
    string[] roleNames
    address[] roleAddresses
    string[] names
    NodeType[] nodeTypes
    string[][] incoming
    string[][] outgoing
    string[][] conditions
    string[] initiatorRoles
    string[] participantRoles
    string[] initiatingMessages
    string[] returnMessages
  }

  %% ---------- ParticipantMutableAsset ----------
  class ParticipantMutableAsset {
    +bytes32 participantType «immutable»
    -bytes32 name
    -bytes32 profile
    -address messagesWriter
    -bytes32[] messages
    +constructor(nmt, creatorPolicy, holderPolicy, participantType)
    +setName(name)
    +setProfile(profile)
    +setMessages(messages)
    +transferFrom(from, to) bool
    +getName() bytes32
    +getProfile() bytes32
    +getMessages() bytes32[]
    +getMessagesWriter() address
    +tokenURI() string
    -_setName(name)
    -_setProfile(profile)
    -_setMessages(messages)
    -_evaluateMessagesUpdate(messages)
  }

  %% ---------- ereditarietà ----------
  ERC721Enumerable <|-- NMT
  NMT <|-- ChoreographyNMT
  NMT <|-- ParticipantNMT
  MutableAsset <|-- ChoreographyMutableAsset
  MutableAsset <|-- ParticipantMutableAsset
  SmartPolicy <|-- MasterSmartPolicy
  SmartPolicy <|-- CreatorSmartPolicy
  SmartPolicy <|-- HolderSmartPolicy
  SmartPolicy <|-- DenyAllSmartPolicy

  %% ---------- strutture interne ----------
  ChoreographyMutableAsset *-- Descriptor
  Descriptor *-- Node : nodesByName
  Node --> NodeType
  ChoreographyMutableAsset ..> InitialModel : decodifica nel constructor

  %% ---------- dipendenze ----------
  ChoreographyNMT ..> ChoreographyMutableAsset : crea
  ChoreographyNMT ..> MasterSmartPolicy : consulta
  ChoreographyNMT ..> ChoreographyTokenURIRenderer : tokenURI
  ChoreographyMutableAsset ..> CreatorSmartPolicy : consulta
  ChoreographyMutableAsset ..> HolderSmartPolicy : consulta
