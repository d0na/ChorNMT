        "key": "K3.lost-update",
        "description": "two updates of the same task, each built on the state before the block: one changes the initiating message, the other the return message",
        "finding": "the last write wins: an update carries the whole node, so the second one writes back the old initiating message; the asset has no version check",
        "transactions": [
          {
            "position": 1,
            "label": "the first update changes the initiating message of Transport Details",
            "from": "Holder",
            "call": "ChoreographyMutableAsset.setNodes",
            "outcome": "allowed",
            "reason": null,
            "gasUsed": "401592"
          },
          {
            "position": 2,
            "label": "the second update changes the return message of Transport Details",
            "from": "Holder",
            "call": "ChoreographyMutableAsset.setNodes",
            "outcome": "allowed",
            "reason": null,
            "gasUsed": "404416"
          }
        ],
        "observed": {
          "task": "Transport Details",
          "before": {
            "initiatingMessage": "Cargo Specification",
            "returnMessage": "Vehicle Assignment"
          },
          "firstUpdate": {
            "initiatingMessage": "Detailed Cargo Specification"
          },
          "secondUpdate": {
            "returnMessage": "Vehicle and Driver Assignment"
          },
          "after": {
            "initiatingMessage": "Cargo Specification",
            "returnMessage": "Vehicle and Driver Assignment"
          },
          "lost": "the initiating message \"Detailed Cargo Specification\" of the first update"
        }
      },
      {
        "key": "K4.limit-under-race",
        "description": "two updates, each inserting one optional task, each within the task limit on the state before the block",
        "finding": "the Creator policy evaluates each update on the state its transaction finds: the limit holds whatever the sender saw",
        "transactions": [
