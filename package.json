{
  "name": "chornmt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "hardhat compile",
    "check:size": "node scripts/check-contract-size.js",
    "check:invariants": "node scripts/check-invariants.js",
    "check:protocol": "node scripts/experiment/protocol.js --check",
    "check:use-cases": "node scripts/check-use-cases.js",
    "check:gas": "node scripts/check-gas.js",
    "docs:uml": "node scripts/render-uml.js",
    "check:uml": "node scripts/render-uml.js --check",
    "start:operations": "hardhat compile && hardhat node",
    "deploy:asset": "node scripts/deploy-local.js",
    "render:asset": "node scripts/render-asset.js",
    "modify:asset": "node scripts/apply-asset-delta.js",
    "test": "npm run test:policies",
    "test:policies": "hardhat run scripts/test-policies.js",
    "evidence:update": "node scripts/experiment/update.js",
    "check:evidence": "node scripts/experiment/check.js",
    "setup:evaluation": "playwright install chromium",
    "clean": "node scripts/clean.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.13",
    "bpmn-js": "^18.29.1",
    "chor-js": "^0.7.1",
    "ethers": "^6.17.0",
    "hardhat": "^3.9.0",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
